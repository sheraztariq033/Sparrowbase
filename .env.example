# =====================================================================
# SparrowBase Monorepo — Environment Variables Template (.env.example)
# =====================================================================

# Global Environment Mode
NODE_ENV=development

# Cloudflare Account & Deployment Settings (optional for local dev)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# API & Documentation Ports
PORT_BACKEND=8787
PORT_DOCS=5173
