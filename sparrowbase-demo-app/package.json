{
  "name": "sparrowbase-demo-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sparrowbase-demo-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply sparrowbase-demo-db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "better-auth": "^1.1.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.4.0",
    "@cloudflare/workers-types": "^4.20240405.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "wrangler": "^3.50.0"
  }
}
